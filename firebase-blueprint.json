{
  "entities": {
    "store_items": {
      "title": "Store Items",
      "description": "Products and services for the Tecnideas Store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "badge": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "price"]
    },
    "categories": {
      "title": "Categories",
      "description": "Store categories for filtering and navigation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "label"]
    },
    "youtube_videos": {
      "title": "YouTube Videos",
      "description": "Featured YouTube videos and channel content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "videoId": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "string" },
        "views": { "type": "string" },
        "featured": { "type": "boolean" }
      },
      "required": ["title", "videoId"]
    },
    "digital_services": {
      "title": "Digital Services",
      "description": "Main digital services for showroom and menu",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "iconName": { "type": "string" },
        "category": { "type": "string" },
        "priceStarting": { "type": "string" },
        "showInMenu": { "type": "boolean" },
        "badge": { "type": "string" }
      },
      "required": ["title"]
    }
  }
}
